# Auth: empty values use persisted secrets and the ownership-protected account creation.
# Set unique values before using environment-provisioned credentials.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PORT=8080

# Tunnel
TUNNEL_NAME=docktun-tunnel
TUNNEL_ID=your-tunnel-uuid
TUNNEL_TOKEN=
TUNNEL_PROTOCOL=http2

# Backend
CLOUDFLARED_CONFIG_PATH=/etc/cloudflared/config.yml
CLOUDFLARED_CONTAINER=docktun-cloudflared
DB_PATH=/app/data/app.db
LISTEN_ADDR=0.0.0.0:3001
SELF_PATH=/opt/projects/docktun
PROJECTS_ROOT=./projects

# Optional Remote Access (Tailscale & WireGuard)
TAILSCALE_STATE_VOLUME=docktun-tailscale-state
WIREGUARD_PORT=51820

